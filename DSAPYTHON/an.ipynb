   "source": [
    "#SWAPPING FOR PYTHON\n",
    "\n",
    "a = 5\n",
    "b = 10\n",
    "\n",
    "a,b = b,a\n",
    "\n",
    "print(a,b)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e0b110fb-8310-43ad-a95b-72d855644774",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[5, 4, 3, 2, 1]\n"
     ]
    }
   ],
   "source": [
    "#reverse the element of a list - using swapping \n",
    "n = [1, 2, 3, 4, 5]\n",
    "\n",
    "i = 0\n",
    "j = len(n) - 1\n",
    "\n",
    "while i < j:\n",
    "    n[i],n[j], = n[j],n[i]\n",
    "    i += 1\n",
    "    j -= 1\n",
    "    \n",
    "print(n)"
   ]
  },
